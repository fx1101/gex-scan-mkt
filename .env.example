# Local secrets for later adapters. Leave values empty. Do not commit a filled-in .env.
# Production Webull keys are not required for Phases 0–1. Sandbox is the default
# when a later phase wires the adapter. This project does not place orders.

WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ENVIRONMENT=sandbox

# Massive (formerly Polygon). Pricing: https://massive.com/pricing?product=options
MASSIVE_API_KEY=

# ThetaData. Pricing: https://www.thetadata.net/pricing
# Exact credential names will be confirmed from ThetaData's docs when that adapter is built.
THETADATA_USERNAME=
THETADATA_PASSWORD=

# Tradier brokerage API. Docs: https://docs.tradier.com
TRADIER_TOKEN=

# Optional outbound alert webhook. Payloads must not include API keys, and must not place trades.
ALERT_WEBHOOK_URL=

# Risk flag. Live order placement is not implemented. Leave this false.
ENABLE_LIVE_ORDERS=false
